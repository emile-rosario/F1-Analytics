{
  "openapi": "3.1.0",
  "info": {
    "title": "F1 Analytics API",
    "version": "1"
  },
  "paths": {
    "/api/calendario/{anio}": {
      "get": {
        "summary": "Calendario",
        "description": "Grandes Premios del año, sin las pruebas de pretemporada.",
        "operationId": "calendario_api_calendario__anio__get",
        "parameters": [
          {
            "name": "anio",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Anio"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Evento"
                  },
                  "title": "Response Calendario Api Calendario  Anio  Get"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
