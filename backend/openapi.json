    "/api/analisis/circuito": {
      "get": {
        "summary": "Analisis Circuito",
        "description": "Mapa de la vuelta más rápida del piloto: velocidad, marchas, curvas y frenadas.\n\nSolo para sesiones terminadas. Responde ``analisis_no_disponible`` en los circuitos que\ntodavía no están en ``circuitos.json``.",
        "operationId": "analisis_circuito_api_analisis_circuito_get",
        "parameters": [
          {
            "name": "sesion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Sesion"
            }
          },
          {
            "name": "piloto",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
