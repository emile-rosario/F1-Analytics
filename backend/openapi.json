    "/api/analisis/gomas": {
      "get": {
        "summary": "Analisis Gomas",
        "description": "Estrategias de todos los pilotos y degradación de las gomas de una carrera o sprint.\n\n``pilotos`` (hasta 3, repitiendo el parámetro) elige de quiénes se mandan las vueltas\nlimpias para la dispersión; sin él se usa el podio. Solo para carreras y sprints terminados.",
        "operationId": "analisis_gomas_api_analisis_gomas_get",
        "parameters": [
          {
            "name": "sesion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Sesion"
            }
          },
          {
            "name": "pilotos",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pilotos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalisisGomas"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Not Found"
          },
